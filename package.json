{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "biome ci . && tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "deploy": "bun run build && wrangler deploy",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lefthook": "2.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.150.0"
  }
}
